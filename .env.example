# Copy to .env.local for local development (`npm run dev`). Not needed for Docker,
# where these are set as Portainer stack environment variables instead.
#
# SAFETY: a local dev server talks to the *real* services you point it at.
# Syncing the shopping list rewrites the real Google Keep list via Home Assistant
# (items are removed and re-added to sort them). Keep HA_URL pointed at a dead
# address unless you really want local runs to touch it.

# Mealie integration (can also be set via the Settings page in the app).
# Leave empty locally if you don't need recipe sync.
MEALIE_URL=
MEALIE_TOKEN=

# Home Assistant integration (can also be set via the Settings page in the app).
# http://127.0.0.1:9 is a deliberately unreachable address: every HA call fails
# fast and the real todo list is never modified. Replace with your real HA URL
# (e.g. http://homeassistant.local:8123) only when you mean it.
HA_URL=http://127.0.0.1:9
HA_TOKEN=
HA_ENTITY=todo.shopping_list

# Optional: password for protected actions (Settings changes, backup download).
# Leave empty to disable the guard.
APP_PASSWORD=

# Data directory for the SQLite database and the backups/ subfolder
DATA_DIR=./data

# Time zone of the process (backup file names). Reminder times follow the
# time zone chosen in Settings.
TZ=Europe/Copenhagen

# The scheduler (push reminders via Home Assistant, nightly Mealie sync) only
# runs in production. Set to 1 to run it in a dev server (it will then send real
# notifications through the configured HA), or 0 to disable it in production.
# VOMMEAL_SCHEDULER=

# Copy to .env.local for local development (not needed for Docker)
# Mealie integration (can also be set via the Settings page in the app)
MEALIE_URL=https://mealie.your-domain.com
MEALIE_TOKEN=your-mealie-api-token

# Home Assistant integration (can also be set via the Settings page in the app)
HA_URL=http://homeassistant.local:8123
HA_TOKEN=your-home-assistant-token
HA_ENTITY=todo.shopping_list

# Data directory for SQLite database
DATA_DIR=./data
